{
  "name": "oracle-cdc-connector",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",
    "database.hostname": "oracle-production",
    "database.port": "1521",
    "database.user": "c##dbzuser",
    "database.password": "${file:/secrets/oracle:password}",
    "database.dbname": "ORCL",
    "database.pdb.name": "XEPDB1",
    "database.server.name": "oracle_prod_server",
    "database.connection.adapter": "logminer",
    "database.history.kafka.bootstrap.servers": "kafka:9092",
    "database.history.kafka.topic": "schema-changes.customer",
    "table.include.list": "ENTERPRISE_CORE_DB.ENTERPRISE_OUTBOX",
    "include.schema.changes": "true",
    "log.mining.strategy": "redo_log_catalog",
    "log.mining.batch.size.default": "20000",
    "log.mining.sleep.time.min.ms": "1000"
  }
}
